# Recon Monitor 8.1.0 configuration
# Keep the real config private: chmod 600 config.env
I_HAVE_AUTHORIZATION="no"
ENABLE_ACTIVE_MODULES="no"
USER_AGENT="ReconMonitor/8.1.0 (authorized security monitoring)"

# macOS Keychain. When enabled, empty mapped secrets are loaded from services
# named recon-monitor-telegram-token, recon-monitor-github-token, etc.
USE_MACOS_KEYCHAIN="no"

# Telegram
TELEGRAM_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NOTIFY_PROVIDER_CONFIG=""

# Alerting
ALERT_ON_BASELINE="false"
ALERT_MIN_SCORE="70"
ALERT_COOLDOWN_HOURS="24"
ALERT_ITEM_LIMIT="15"
ALERT_CONFIRMED_ONLY="false"

# Dashboard: session auth + RBAC is the v3 default when enabled.
DASHBOARD_HOST="127.0.0.1"
DASHBOARD_PORT="8787"
DASHBOARD_ALLOW_REMOTE="no"
DASHBOARD_AUTH_ENABLED="yes"
DASHBOARD_AUTH_MODE="session"
DASHBOARD_TRUST_PROXY_HEADERS="no"
DASHBOARD_ALLOWED_ORIGINS=""
# Compatibility Basic-auth fields are retained for migrations.
DASHBOARD_AUTH_USERNAME=""
DASHBOARD_AUTH_SALT=""
DASHBOARD_AUTH_HASH=""
DASHBOARD_AUTH_ITERATIONS="310000"

# Local API
API_HOST="127.0.0.1"
API_PORT="8790"

# Optional PostgreSQL analytics mirror (not the primary transactional DB).
POSTGRES_DSN=""

# Updates: private GitHub Releases via authenticated gh CLI by default.
# Override the repository if needed. RECON_UPDATE_MANIFEST remains available for legacy trusted manifests.
RECON_UPDATE_REPO="alirezasafariii/recon-monitor"
RECON_UPDATE_MANIFEST=""

# Retention
KEEP_RUNS_PER_TARGET="30"
KEEP_RAW_DATA_DAYS="30"
KEEP_REPORTS_DAYS="365"
MIN_FREE_DISK_GB="2"
STALE_STATE_HOURS="24"
AUTO_RETENTION="true"
AUTO_DIGEST_HOURS="24"

# Recon Monitor 6 platform
PERFORMANCE_SLOW_MS="100"
DEFAULT_REVALIDATION_DAYS="7"
NOTIFICATION_DEDUP_HOURS="24"
RETENTION_RAW_HTTP_DAYS="90"
RETENTION_JAVASCRIPT_DAYS="180"
RETENTION_TEMP_EXPORT_DAYS="30"
RETENTION_LOG_DAYS="45"
RETENTION_BACKUP_COUNT="10"
