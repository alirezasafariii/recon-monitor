    "ssrf": {
      "canonical_reference": "https://github.com/advisories/GHSA-wx9v-ffw3-45wg",
      "source_project": "vulnerability-lookup/vulnerability-lookup",
      "source_root": "GHSA-wx9v-ffw3-45wg",
      "successful_resource_count": 1,
      "successful_resources": [
        {
          "fetch_reference": "https://api.github.com/repos/vulnerability-lookup/vulnerability-lookup/commits/a3cf621c2583c45227a5b7880123ba0ffef3cc0f",
          "has_body_or_message": true,
          "payload_identity": {
            "html_url": "https://github.com/vulnerability-lookup/vulnerability-lookup/commit/a3cf621c2583c45227a5b7880123ba0ffef3cc0f",
            "message": "fix: [security] enforce outbound-URL policy on remote-instance sync (SSRF-VULN-01)\n\nRemote-instance addresses were validated for URL syntax only, then dereferenced\nby the sync worker with requests.get() following redirects and with no network\nboundary. An admin (admin:access + CSRF) could therefore point sync at internal\nor cloud-metadata HTTP(S) services, a stored server-side request forgery.\n\nAdd a shared outbound-URL policy (website/lib/remote_url.py) applied at two\npoints:\n\n- storage time: RemoteInstance.address and the admin form reject non-HTTP(S)\n  URLs and IP-literal hosts in private, loopback, link-local, multicast,\n  reserved or unspecified ranges;\n- request time: safe_get() resolves the host, rejects any non-public resolved\n  address, and follows redirects manually so a 3xx to an internal host is\n  rejected instead of followed.\n\nThe sync worker now fetches through safe_get() and treats a blocked\ndestination as a non-retryable failure. Adds tests for the policy, host\nresolution, and redirect-to-internal rejection.\n\nReported-by: openai/gpt-5.5-cyber-preview (reasoning level: high)\nReported-by: EUVD @ ENISA Team\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>",
            "number": null,
            "sha": "a3cf621c2583c45227a5b7880123ba0ffef3cc0f",
            "title": null
          },
          "reference": "https://github.com/vulnerability-lookup/vulnerability-lookup/commit/a3cf621c2583c45227a5b7880123ba0ffef3cc0f",
          "resource_type": "commit",
          "snapshot_sha256": "b570d36bc3ffc81c91379aa123bda45ca0548ba508888f50ce0180874585991b"
        }
      ]
