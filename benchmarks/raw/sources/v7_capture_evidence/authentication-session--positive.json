          "contents_url": "https://api.github.com/repos/tammam-alsoleman/decentralized-real-estate-platform/contents/services%2Fauth-service%2Fsrc%2Fmodules%2Fauth%2Fapplication%2Fuse-cases%2Fvalidate-access-token.use-case.spec.ts?ref=f20b37ac8c5cb4e25ecc70441a756eb285b00e4d",
          "deletions": 0,
          "filename": "services/auth-service/src/modules/auth/application/use-cases/validate-access-token.use-case.spec.ts",
          "patch": "@@ -0,0 +1,108 @@\n+import { SessionEntity } from '../../domain/entities/session.entity';\n+import { UserEntity } from '../../domain/entities/user.entity';\n+import { UserRole } from '../../domain/enums/user-role.enum';\n+import { UserStatus } from '../../domain/enums/user-status.enum';\n+import { AuthTokenService } from '../../infrastructure/security/auth-token.service';\n+import { ValidateAccessTokenUseCase } from './validate-access-token.use-case';\n+\n+const now = new Date('2026-08-15T10:00:00.000Z');\n+\n+function activeUser(overrides: Partial<UserEntity> = {}) {\n+  return new UserEntity({\n+    id: 'user-1',\n+    phoneNumber: '+15550000001',\n+    email: 'user@example.test',\n+    passwordHash: null,\n+    role: UserRole.CITIZEN,\n+    status: UserStatus.ACTIVE,\n+    emailVerifiedAt: new Date('2026-08-15T09:00:00.000Z'),\n+    phoneVerifiedAt: new Date('2026-08-15T09:00:00.000Z'),\n+    createdAt: new Date('2026-08-01T00:00:00.000Z'),\n+    updatedAt: now,\n+    ...overrides,\n+  });\n+}\n+\n+function session(overrides: Partial<SessionEntity> = {}) {\n+  return new SessionEntity({\n+    id: 'session-1',\n+    userId: 'user-1',\n+    jti: 'jti-1',\n+    refreshTokenHash: 'refresh-hash',\n+    expiresAt: new Date('2026-08-15T11:00:00.000Z'),\n+    revokedAt: null,\n+    createdAt: now,\n+    updatedAt: now,\n+    ...overrides,\n+  });\n+}\n+\n+describe('ValidateAccessTokenUseCase', () => {\n+  let originalSecret: string | undefined;\n+  let authTokenService: AuthTokenService;\n+  let sessionRepository: { findById: jest.Mock };\n+  let userRepository: { findById: jest.Mock };\n+  let useCase: ValidateAccessTokenUseCase;\n+\n+  beforeEach(() => {\n+    jest.useFakeTimers().setSystemTime(now);\n+    originalSecret = process.env.AUTH_JWT_ACCESS_TOKEN_SECRET;\n+    process.env.AUTH_JWT_ACCESS_TOKEN_SECRET = 'test-jwt-secret';\n+\n+    authTokenService = new AuthTokenService();\n+    sessionRepository = {\n+      findById: jest.fn().mockResolvedValue(session()),\n+    };\n+    userRepository = {\n+      findById: jest.fn().mockResolvedValue(activeUser()),\n+    };\n+    useCase = new ValidateAccessTokenUseCase(\n+      authTokenService,\n+      sessionRepository as never,\n+      userRepository as never,\n+    );\n+  });\n+\n+  afterEach(() => {\n+    if (originalSecret === undefined) {\n+      delete process.env.AUTH_JWT_ACCESS_TOKEN_SECRET;\n+    } else {\n+      process.env.AUTH_JWT_ACCESS_TOKEN_SECRET = originalSecret;\n+    }\n+    jest.useRealTimers();\n+  });\n+\n+  it('validates a token when the session belongs to the token subject', async () => {\n+    const accessToken = authTokenService.generateAccessToken(\n+      activeUser(),\n+      'session-1',\n+    );\n+\n+    await expect(useCase.execute({ accessToken })).resolves.toMatchObject({\n+      valid: true,\n+      userId: 'user-1',\n+      sessionId: 'session-1',\n+    });\n+  });\n+\n+  it('rejects a token when the session belongs to a different user', async () => {\n+    sessionRepository.findById.mockResolvedValue(\n+      session({ userId: 'attacker-user' }),\n+    );\n+    const accessToken = authTokenService.generateAccessToken(\n+      activeUser(),\n+      'session-1',\n+    );\n+\n+    await expect(useCase.execute({ accessToken })).resolves.toEqual({\n+      valid: false,\n+      userId: '',\n+      email: '',\n+      phoneNumber: '',\n+      role: '',\n+      status: '',\n+      sessionId: '',\n+    });\n+    expect(userRepository.findById).not.toHaveBeenCalled();\n+  });\n+});",
