+		panic("queue: unbalanced DoneItem")
+	}
+	q.active--
+	q.changed.Broadcast()
+}
+
+// WorkState is a synchronized snapshot of pending and tracked active work.
+func (q *Queue) WorkState() (int, int) {
+	q.Lock()
+	defer q.Unlock()
+	pending := q.stack.Len()
+	if q.Strategy == BreadthFirst {
+		pending = q.priorityQueue.Len()
+	}
+	return pending, q.active
+}
+
+// PopTrackedWithContext finishes only when pending and in-flight work are
+// both empty. Every delivered item must be paired with DoneItem.
+func (q *Queue) PopTrackedWithContext(ctx context.Context) chan interface{} {
+	items := make(chan interface{})
+	go func() {
+		defer close(items)
+		stop := context.AfterFunc(ctx, func() {
+			q.Lock()
+			q.changed.Broadcast()
+			q.Unlock()
+		})
+		defer stop()
+		for {
+			q.Lock()
+			var item interface{}
+			for {
+				if ctx.Err() != nil {
+					q.Unlock()
+					return
+				}
+				switch q.Strategy {
+				case BreadthFirst:
+					item = q.priorityQueue.Pop()
+				case DepthFirst:
+					item = q.stack.Pop()
+				}
+				if item != nil {
+					q.active++
+					break
+				}
+				if q.active == 0 {
+					q.Unlock()
+					return
+				}
+				q.changed.Wait()
+			}
+			q.Unlock()
+			select {
+			case items <- item:
+			case <-ctx.Done():
+				q.DoneItem()
+				return
+			}
+		}
+	}()
+	return items
 }
 
