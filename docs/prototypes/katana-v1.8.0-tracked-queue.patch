 }
+
+// originContentKey keeps exact content deduplication local to the seed origin.
+// A fixed-size key avoids copying potentially large response bodies.
+func originContentKey(seed *url.URL, data []byte) []byte {
+	scheme := strings.ToLower(seed.Scheme)
+	host := strings.ToLower(seed.Hostname())
+	port := seed.Port()
+	if port == "" {
+		if scheme == "https" {
+			port = "443"
+		} else if scheme == "http" {
+			port = "80"
+		}
+	}
+	h := sha256.New()
+	h.Write([]byte("katana.standard.origin-content.v1\x00"))
+	h.Write([]byte(scheme + "://" + net.JoinHostPort(host, port)))
+	h.Write([]byte{0})
+	h.Write(data)
+	return h.Sum(nil)
+}
