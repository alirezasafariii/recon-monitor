@@ -0,0 +1,51 @@
+package common
+
+import (
+	"encoding/json"
+	"github.com/projectdiscovery/katana/pkg/navigation"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func TestReconDiagnosticsConcurrent(t *testing.T) {
+	var d reconDiagnostics
+	var wg sync.WaitGroup
+	for i := 0; i < 30; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			d.observe(&navigation.Response{ReconSkipReason: "exact_content_duplicate"})
+			d.observe(&navigation.Response{ReconSkipReason: "similarity_filtered"})
+			d.observe(nil)
+		}()
+	}
+	wg.Wait()
+	p := filepath.Join(t.TempDir(), "diagnostics.jsonl")
+	if err := writeDiagnostics(p, "https://example.test/", &d); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var row struct {
+		Reasons map[string]int64 `json:"unparsed_reasons"`
+	}
+	if err := json.Unmarshal(b, &row); err != nil {
+		t.Fatal(err)
+	}
+	for _, k := range []string{"exact_content_duplicate", "similarity_filtered", "missing_response_reader"} {
+		if row.Reasons[k] != 30 {
+			t.Fatalf("%s=%d", k, row.Reasons[k])
+		}
+	}
+	report := newCompletion("https://example.test/", nil, 1, 0, 0, 0, 0)
+	if report.StopReason != "queue_exhausted" {
+		t.Fatal("diagnostics changed completion")
+	}
+	if err := writeDiagnostics(filepath.Join(p, "invalid"), "x", &d); err == nil {
+		t.Fatal("write failure ignored")
+	}
+}
