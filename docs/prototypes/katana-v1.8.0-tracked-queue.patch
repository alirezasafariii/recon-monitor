diff --git a/pkg/engine/common/recon_completion.go b/pkg/engine/common/recon_completion.go
new file mode 100644
index 0000000..b800340
--- /dev/null
+++ b/pkg/engine/common/recon_completion.go
@@ -0,0 +1,99 @@
+package common
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/projectdiscovery/katana/pkg/navigation"
+	"os"
+	"sync"
+	"sync/atomic"
+)
+
+const completionContract = "recon.katana.standard.completion.v1"
+
+type reconCompletion struct {
+	Contract   string `json:"contract"`
+	Origin     string `json:"origin"`
+	StopReason string `json:"stop_reason"`
+	Attempted  int64  `json:"attempted_requests"`
+	Failed     int64  `json:"failed_requests"`
+	Limited    int64  `json:"limited_requests"`
+	Pending    int    `json:"pending_items"`
+	Active     int    `json:"active_items"`
+}
+
+func newCompletion(origin string, ctxErr error, attempted, failed, limited int64, pending, active int) reconCompletion {
+	reason := "queue_exhausted"
+	switch {
+	case errors.Is(ctxErr, context.DeadlineExceeded):
+		reason = "deadline"
+	case ctxErr != nil:
+		reason = "cancelled"
+	case limited > 0:
+		reason = "page_limit"
+	case failed > 0:
+		reason = "request_errors"
+	case attempted == 0 || pending != 0 || active != 0:
+		reason = "unknown"
+	}
+	return reconCompletion{completionContract, origin, reason, attempted, failed, limited, pending, active}
+}
+
+var completionMu sync.Mutex
+
+func writeCompletion(path string, report reconCompletion) error {
+	completionMu.Lock()
+	defer completionMu.Unlock()
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0600)
+	if err != nil {
+		return err
+	}
+	if err := json.NewEncoder(f).Encode(report); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	return f.Close()
+}
+
+// Fixed-size counters keep diagnostics bounded and separate from contract v1.
+type reconDiagnostics struct{ exact, similarity, missing atomic.Int64 }
+
+func (d *reconDiagnostics) observe(resp *navigation.Response) {
+	switch {
+	case resp != nil && resp.ReconSkipReason == "exact_content_duplicate":
+		d.exact.Add(1)
+	case resp != nil && resp.ReconSkipReason == "similarity_filtered":
+		d.similarity.Add(1)
+	default:
+		d.missing.Add(1)
+	}
+}
+func writeDiagnostics(path, origin string, d *reconDiagnostics) error {
+	completionMu.Lock()
+	defer completionMu.Unlock()
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0600)
+	if err != nil {
+		return err
+	}
+	report := struct {
+		Contract string           `json:"contract"`
+		Origin   string           `json:"origin"`
+		Reasons  map[string]int64 `json:"unparsed_reasons"`
+	}{
+		"recon.katana.standard.diagnostics.v1", origin, map[string]int64{
+			"exact_content_duplicate": d.exact.Load(), "similarity_filtered": d.similarity.Load(), "missing_response_reader": d.missing.Load()}}
+	if err := json.NewEncoder(f).Encode(report); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	return f.Close()
+}
diff --git a/pkg/engine/common/recon_completion_test.go b/pkg/engine/common/recon_completion_test.go
new file mode 100644
index 0000000..68e1799
--- /dev/null
+++ b/pkg/engine/common/recon_completion_test.go
@@ -0,0 +1,111 @@
+package common
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func TestReconCompletionNeverConfusesStopsWithQuiescence(t *testing.T) {
+	cases := []struct {
+		name                       string
+		err                        error
+		attempted, failed, limited int64
+		pending, active            int
+		want                       string
+	}{
+		{"complete", nil, 3, 0, 0, 0, 0, "queue_exhausted"},
+		{"deadline", context.DeadlineExceeded, 2, 1, 0, 1, 0, "deadline"},
+		{"cancelled", context.Canceled, 2, 0, 0, 0, 0, "cancelled"},
+		{"request error", nil, 3, 1, 0, 0, 0, "request_errors"},
+		{"page limit", nil, 3, 0, 1, 0, 0, "page_limit"},
+		{"no observation", nil, 0, 0, 0, 0, 0, "unknown"},
+		{"pending", nil, 3, 0, 0, 1, 0, "unknown"},
+		{"active", nil, 3, 0, 0, 0, 1, "unknown"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r := newCompletion("http://127.0.0.1:1234/", tc.err, tc.attempted, tc.failed, tc.limited, tc.pending, tc.active)
+			if r.StopReason != tc.want {
+				t.Fatalf("got %s want %s", r.StopReason, tc.want)
+			}
+			if r.Contract != completionContract {
+				t.Fatal("missing contract identity")
+			}
+		})
+	}
+}
+
+func TestReconCompletionArtifactIsJSONLAndWriteFailureIsReturned(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "completion.jsonl")
+	r := newCompletion("http://127.0.0.1:1234/", nil, 3, 0, 0, 0, 0)
+	if err := writeCompletion(path, r); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeCompletion(path, r); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	d := json.NewDecoder(f)
+	for i := 0; i < 2; i++ {
+		var got reconCompletion
+		if err := d.Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != r {
+			t.Fatal("artifact changed report")
+		}
+	}
+	if err := writeCompletion(dir, r); err == nil {
+		t.Fatal("write failure hidden")
+	}
+}
+
+func TestReconCompletionConcurrentOriginsWriteWholeEvents(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "completion.jsonl")
+	errors := make(chan error, 24)
+	var workers sync.WaitGroup
+	for i := 0; i < 24; i++ {
+		workers.Add(1)
+		go func(index int) {
+			defer workers.Done()
+			errors <- writeCompletion(path, newCompletion(fmt.Sprintf("http://127.0.0.1:%d", 20000+index), nil, 3, 0, 0, 0, 0))
+		}(i)
+	}
+	workers.Wait()
+	close(errors)
+	for err := range errors {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := bytes.Split(bytes.TrimSpace(data), []byte("\n"))
+	if len(lines) != 24 {
+		t.Fatalf("lost events: %d", len(lines))
+	}
+	origins := make(map[string]bool)
+	for _, line := range lines {
+		var report reconCompletion
+		if err := json.Unmarshal(line, &report); err != nil {
+			t.Fatal(err)
+		}
+		if origins[report.Origin] || report.StopReason != "queue_exhausted" {
+			t.Fatalf("invalid event: %+v", report)
+		}
+		origins[report.Origin] = true
+	}
+}
