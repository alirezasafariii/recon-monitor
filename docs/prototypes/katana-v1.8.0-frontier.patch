+	} {
+		if got, e := openCheckpoint(dir, "http://example.test/", tc.binding, tc.depth, tc.valid); e == nil {
+			got.close()
+			t.Fatal("accepted incompatible checkpoint")
+		}
+	}
+}
+func TestReconCheckpointConcurrentAdmissionsAndAcknowledgements(t *testing.T) {
+	c := checkpointOpen(t, t.TempDir())
+	defer c.close()
+	var wg sync.WaitGroup
+	for n := 0; n < 20; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r := &navigation.Request{URL: "http://example.test/", Method: "GET", Depth: 1}
