@@ -0,0 +1,59 @@
+package standard
+
+import (
+	"bytes"
+	"github.com/projectdiscovery/katana/pkg/navigation"
+	"github.com/projectdiscovery/katana/pkg/utils/filters"
+	"net/http"
+	"net/url"
+	"testing"
+)
+
+func TestParsingContentContext(t *testing.T) {
+	seed, _ := url.Parse("http://example.test/")
+	key := func(document, final string, depth int) []byte {
+		u, _ := url.Parse(final)
+		return parsingContentKey(seed, &navigation.Request{URL: document, Method: "GET", Depth: depth}, &http.Response{StatusCode: 200, Request: &http.Request{URL: u}}, []byte(`<a href="proof">proof</a>`))
+	}
+	a := key("http://example.test/a/", "http://example.test/a/", 1)
+	if !bytes.Equal(a, key("http://example.test/a/", "http://example.test/a/", 1)) {
+		t.Fatal("identical context differs")
+	}
+	for _, b := range [][]byte{
+		key("http://example.test/b/", "http://example.test/a/", 1),
+		key("http://example.test/a/", "http://example.test/b/", 1),
+		key("http://example.test/a/", "http://example.test/a/", 0),
+		key("http://example.test/a/?x=1", "http://example.test/a/", 1),
+	} {
+		if bytes.Equal(a, b) {
+			t.Fatal("distinct parsing context discarded")
+		}
+	}
+	f, err := filters.NewSimple()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if !f.UniqueContent(a) || f.UniqueContent(a) {
+		t.Fatal("identical context dedup changed")
+	}
+	if !f.UniqueContent(key("http://example.test/b/", "http://example.test/b/", 1)) {
+		t.Fatal("relative-base context rejected")
+	}
+}
+
+func TestParsingContentResponseMetadata(t *testing.T) {
+	seed, _ := url.Parse("https://example.test/")
+	req := &navigation.Request{URL: seed.String(), Method: "GET", Depth: 1}
+	resp := &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"text/html"}}, Request: &http.Request{URL: seed}}
+	key := parsingContentKey(seed, req, resp, []byte("same"))
+	resp.StatusCode = 302
+	if bytes.Equal(key, parsingContentKey(seed, req, resp, []byte("same"))) {
+		t.Fatal("status ignored")
+	}
+	resp.StatusCode = 200
+	resp.Header.Set("Content-Type", "application/javascript")
+	if bytes.Equal(key, parsingContentKey(seed, req, resp, []byte("same"))) {
+		t.Fatal("headers ignored")
+	}
+}
