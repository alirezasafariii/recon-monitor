@@ -0,0 +1,44 @@
+package utils
+
+import "testing"
+
+func TestScriptEventNamesAreNotEndpoints(t *testing.T) {
+	for _, script := range []string{
+		`w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' }); j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl`,
+		`push({"event": "gtm.js"}); script.src='https://www.googletagmanager.com/gtm.js?id='`,
+		`push({event /* comment */ : /* comment */ 'gtm.js'}); script.src='https://www.googletagmanager.com/gtm.js?id='`,
+	} {
+		matches := ExtractScriptEndpoints(script)
+		foundExternal := false
+		for _, value := range matches {
+			if value == "gtm.js" {
+				t.Fatalf("event became a local URL: %q", matches)
+			}
+			if value == "https://www.googletagmanager.com/gtm.js?id=" {
+				foundExternal = true
+			}
+		}
+		if !foundExternal {
+			t.Fatalf("external reference lost: %q", matches)
+		}
+	}
+}
+
+func TestScriptRealReferencesRemainCandidates(t *testing.T) {
+	for _, script := range []string{
+		`script.src='gtm.js'`, `fetch('gtm.js')`, `load({url:'gtm.js'})`,
+		`push({event:'gtm.js'}); script.src='gtm.js'`,
+		`/* event:'gtm.js' */ script.src='gtm.js'`,
+		"const template = `event: 'gtm.js'`; script.src='gtm.js'",
+	} {
+		found := false
+		for _, value := range ExtractScriptEndpoints(script) {
+			if value == "gtm.js" {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatalf("real reference lost: %s", script)
+		}
+	}
+}
diff --git a/pkg/utils/script_sources.go b/pkg/utils/script_sources.go
new file mode 100644
index 0000000..7bb1ccf
--- /dev/null
+++ b/pkg/utils/script_sources.go
@@ -0,0 +1,31 @@
+//go:build !(386 || windows)
+
+package utils
+
+import (
+	"github.com/Mzack9999/jsluice"
+	"strings"
+)
+
+const StructuredScriptSources = true
+
+// ExtractLiteralScriptSources supplements the regex with literal DOM src/href
+// assignments. It does not evaluate concatenation or infer configuration aliases.
+func ExtractLiteralScriptSources(data string) []string {
+	if len(data) > 512*1024 || (!strings.Contains(data, "src") && !strings.Contains(data, "href")) {
+		return nil
+	}
+	var result []string
+	jsluice.NewAnalyzer([]byte(data)).Query("(assignment_expression) @assignment", func(n *jsluice.Node) {
+		left, right := n.ChildByFieldName("left"), n.ChildByFieldName("right")
+		if left == nil || right == nil || left.Type() != "member_expression" || right.Type() != "string" {
+			return
+		}
+		property := left.ChildByFieldName("property")
+		if property == nil || (property.Content() != "src" && property.Content() != "href") {
+			return
+		}
+		result = append(result, jsluice.DecodeString(right.Content()))
+	})
+	return result
+}
