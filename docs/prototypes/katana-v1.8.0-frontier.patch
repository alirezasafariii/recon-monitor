diff --git a/pkg/engine/common/recon_checkpoint_test.go b/pkg/engine/common/recon_checkpoint_test.go
new file mode 100644
index 0000000..a4b1bfb
--- /dev/null
+++ b/pkg/engine/common/recon_checkpoint_test.go
@@ -0,0 +1,282 @@
+package common
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/projectdiscovery/fastdialer/fastdialer"
+	"github.com/projectdiscovery/katana/pkg/navigation"
+	"github.com/projectdiscovery/katana/pkg/types"
+	"github.com/projectdiscovery/katana/pkg/utils/extensions"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func checkpointOpen(t *testing.T, dir string) *reconCheckpoint {
+	t.Helper()
+	if e := os.Chmod(dir, 0700); e != nil {
+		t.Fatal(e)
+	}
+	c, e := openCheckpoint(dir, "http://example.test/", "binding", 3, func(s string) bool { return validFrontierURL(s) })
+	if e != nil {
+		t.Fatal(e)
+	}
+	return c
+}
+func TestReconCheckpointPersistsDepthDoneAndUnacknowledged(t *testing.T) {
+	dir := t.TempDir()
+	c := checkpointOpen(t, dir)
+	a := &navigation.Request{URL: "http://example.test/a/", Method: "GET", Depth: 1}
+	b := &navigation.Request{URL: "http://example.test/a/proof", Method: "GET", Depth: 2, Source: a.URL, Tag: "a", Attribute: "href"}
+	if e := c.admit(a); e != nil {
+		t.Fatal(e)
+	}
+	if e := c.admit(b); e != nil {
+		t.Fatal(e)
+	}
+	if e := c.acknowledge(a); e != nil {
+		t.Fatal(e)
+	}
+	c.close()
+	c = checkpointOpen(t, dir)
+	defer c.close()
+	s := c.snapshot()
+	if len(s) != 2 {
+		t.Fatal(s)
+	}
+	found := map[string]frontierItem{}
+	for _, i := range s {
+		found[i.URL] = i
+	}
+	if !found[a.URL].Done || found[b.URL].Done || found[b.URL].Depth != 2 || found[b.URL].Source != a.URL || found[b.URL].Tag != "a" || found[b.URL].Attribute != "href" {
+		t.Fatal(s)
+	}
+	st, _ := os.Stat(c.path)
+	if st.Mode().Perm() != 0600 {
+		t.Fatal(st.Mode())
+	}
+}
+func TestReconCheckpointRejectsChangedBindingScopeAndDepth(t *testing.T) {
+	dir := t.TempDir()
+	c := checkpointOpen(t, dir)
+	if e := c.admit(&navigation.Request{URL: "http://example.test/a", Method: "GET", Depth: 2}); e != nil {
