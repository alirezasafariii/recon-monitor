+		t.Fatal(e)
+	}
+	return c
+}
+func TestReconCheckpointPersistsDepthDoneAndUnacknowledged(t *testing.T) {
+	dir := t.TempDir()
+	c := checkpointOpen(t, dir)
+	a := &navigation.Request{URL: "http://example.test/a/", Method: "GET", Depth: 1}
+	b := &navigation.Request{URL: "http://example.test/a/proof", Method: "GET", Depth: 2, Source: a.URL, Tag: "a", Attribute: "href"}
+	if e := c.admit(a); e != nil {
+		t.Fatal(e)
+	}
+	if e := c.admit(b); e != nil {
+		t.Fatal(e)
+	}
+	if e := c.acknowledge(a); e != nil {
+		t.Fatal(e)
+	}
+	c.close()
+	c = checkpointOpen(t, dir)
+	defer c.close()
+	s := c.snapshot()
+	if len(s) != 2 {
+		t.Fatal(s)
+	}
+	found := map[string]frontierItem{}
+	for _, i := range s {
+		found[i.URL] = i
+	}
+	if !found[a.URL].Done || found[b.URL].Done || found[b.URL].Depth != 2 || found[b.URL].Source != a.URL || found[b.URL].Tag != "a" || found[b.URL].Attribute != "href" {
+		t.Fatal(s)
+	}
+	st, _ := os.Stat(c.path)
+	if st.Mode().Perm() != 0600 {
+		t.Fatal(st.Mode())
+	}
