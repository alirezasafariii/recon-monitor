+// withoutExecutableScripts keeps HTML attributes and non-JavaScript data blocks.
+// Inline JavaScript is handled by its dedicated parsers, not the body regex.
+func withoutExecutableScripts(body string) string {
+	z := html.NewTokenizer(strings.NewReader(body))
+	var out strings.Builder
+	skip := false
+	for {
+		kind := z.Next()
+		if kind == html.ErrorToken {
+			if z.Err() != io.EOF {
+				return body
+			}
+			return out.String()
+		}
+		raw := string(z.Raw())
+		if kind == html.StartTagToken {
+			token := z.Token()
+			if token.Data == "script" {
+				media := ""
+				for _, a := range token.Attr {
+					if a.Key == "type" {
+						media = strings.ToLower(strings.TrimSpace(a.Val))
+					}
+				}
+				skip = media == "" || media == "module" || strings.Contains(media, "javascript") || strings.Contains(media, "ecmascript")
+			}
+		}
+		if kind == html.EndTagToken {
+			token := z.Token()
+			if token.Data == "script" {
+				skip = false
+			}
+		}
+		if kind != html.TextToken || !skip {
+			out.WriteString(raw)
+		}
+	}
+}
