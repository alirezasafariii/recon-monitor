+	if e := c.admit(r); e != nil {
+		t.Fatal(e)
+	}
+	if e := c.acknowledge(r); e != nil {
+		t.Fatal(e)
+	}
+	if e := c.recheckSeed(r.URL); e != nil {
+		t.Fatal(e)
