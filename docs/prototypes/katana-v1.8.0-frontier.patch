+func TestReconCheckpointUnsupportedRequestAndFailedWriteFailClosed(t *testing.T) {
+	for _, r := range []*navigation.Request{{URL: "http://example.test/", Method: "POST", Body: "secret"}, {URL: "http://example.test/", Method: "GET", Headers: map[string]string{"Cookie": "secret"}}, {URL: "http://u:p@example.test/", Method: "GET"}} {
