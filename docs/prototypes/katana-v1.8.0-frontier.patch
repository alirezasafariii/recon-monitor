+func TestReconCheckpointRequiredFields(t *testing.T) {
+	for _, raw := range []string{`{"contract":"x","origin":"http://example.test/","binding":"x","items":[{"url":"http://example.test/a","done":true}]}`, `{"contract":"x","origin":"http://example.test/","binding":"x","items":null}`} {
+		if requireCheckpointFields([]byte(raw)) == nil {
