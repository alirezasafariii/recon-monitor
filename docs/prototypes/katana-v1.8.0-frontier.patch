+
+// originContentKey keeps exact content deduplication local to the seed origin.
+// A fixed-size key avoids copying potentially large response bodies.
+func originContentKey(seed *url.URL, data []byte) []byte {
+	scheme := strings.ToLower(seed.Scheme)
+	host := strings.ToLower(seed.Hostname())
+	port := seed.Port()
+	if port == "" {
+		if scheme == "https" {
+			port = "443"
+		} else if scheme == "http" {
+			port = "80"
+		}
+	}
+	h := sha256.New()
+	h.Write([]byte("katana.standard.origin-content.v1\x00"))
+	h.Write([]byte(scheme + "://" + net.JoinHostPort(host, port)))
+	h.Write([]byte{0})
+	h.Write(data)
+	return h.Sum(nil)
+}
+
+// parsingContentKey conservatively preserves every distinct parser context.
+// The parser uses both the requested document URL and final response URL.
+func parsingContentKey(seed *url.URL, request *navigation.Request, response *http.Response, data []byte) []byte {
+	finalURL := ""
+	if response.Request != nil && response.Request.URL != nil {
+		finalURL = response.Request.URL.String()
+	}
+	context, _ := json.Marshal(struct {
+		DocumentURL string
+		FinalURL    string
+		Depth       int
+		Method      string
+		Status      int
+		Headers     http.Header
+	}{request.URL, finalURL, request.Depth, request.Method, response.StatusCode, response.Header})
+	h := sha256.New()
+	h.Write([]byte("katana.standard.parsing-content.v1\x00"))
+	h.Write(originContentKey(seed, data))
+	h.Write(context)
+	return h.Sum(nil)
+}
