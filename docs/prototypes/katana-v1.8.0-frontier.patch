@@ -0,0 +1,58 @@
+package standard
+
+import (
+	"bytes"
+	"github.com/projectdiscovery/katana/pkg/utils/filters"
+	"net/url"
+	"testing"
+)
+
+func TestOriginContentKey(t *testing.T) {
+	key := func(raw, body string) []byte {
+		u, err := url.Parse(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return originContentKey(u, []byte(body))
+	}
+	a := key("http://example.test/", "same")
+	for _, raw := range []string{"http://EXAMPLE.test:80/path", "http://example.test/other?x=1"} {
+		if !bytes.Equal(a, key(raw, "same")) {
+			t.Fatalf("same origin differs: %s", raw)
+		}
+	}
+	for _, raw := range []string{"https://example.test/", "http://other.test/", "http://example.test:81/"} {
+		if bytes.Equal(a, key(raw, "same")) {
+			t.Fatalf("different origin collides: %s", raw)
+		}
+	}
+	if bytes.Equal(a, key("http://example.test/", "different")) {
+		t.Fatal("different content collides")
+	}
+	if len(a) != 32 {
+		t.Fatal("key must be fixed size")
+	}
+	if !bytes.Equal(key("http://[::1]/", "same"), key("http://[::1]:80/path", "same")) {
+		t.Fatal("IPv6 default port differs")
+	}
+}
+
+func TestOriginContentDedupRetainedWithinOrigin(t *testing.T) {
+	f, err := filters.NewSimple()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	a, _ := url.Parse("http://a.example.test/")
+	b, _ := url.Parse("http://b.example.test/")
+	body := []byte("same response with relative child")
+	if !f.UniqueContent(originContentKey(a, body)) {
+		t.Fatal("first response rejected")
+	}
+	if f.UniqueContent(originContentKey(a, body)) {
+		t.Fatal("same-origin duplicate accepted")
+	}
+	if !f.UniqueContent(originContentKey(b, body)) {
+		t.Fatal("other-origin response rejected")
+	}
+}
