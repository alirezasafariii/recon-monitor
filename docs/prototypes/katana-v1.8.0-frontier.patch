+}
+func TestReconCheckpointConcurrentAdmissionsAndAcknowledgements(t *testing.T) {
+	c := checkpointOpen(t, t.TempDir())
+	defer c.close()
+	var wg sync.WaitGroup
+	for n := 0; n < 20; n++ {
