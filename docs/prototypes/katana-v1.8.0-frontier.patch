--- /dev/null
+++ b/pkg/engine/common/recon_checkpoint.go
@@ -0,0 +1,399 @@
+package common
+
+// Experimental standard-engine checkpoint. Work is admitted durably before
+// dispatch, and acknowledged only after parsing and child admission. A crash
+// can repeat work, but cannot turn an unprocessed request into completed work.
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"sync"
+
+	"github.com/projectdiscovery/katana/pkg/navigation"
+	"github.com/projectdiscovery/katana/pkg/types"
+)
+
+const checkpointContract = "recon.katana.standard.frontier.v1"
+const checkpointMaxItems = 50000
+const checkpointMaxBytes = 64 << 20
+
+type frontierItem struct {
+	URL       string `json:"url"`
+	Depth     int    `json:"depth"`
+	Done      bool   `json:"done"`
+	Source    string `json:"source,omitempty"`
+	Tag       string `json:"tag,omitempty"`
+	Attribute string `json:"attribute,omitempty"`
+}
+type frontierDocument struct {
+	Contract string         `json:"contract"`
+	Origin   string         `json:"origin"`
+	Binding  string         `json:"binding"`
+	Items    []frontierItem `json:"items"`
+}
+type reconCheckpoint struct {
+	sync.Mutex
+	path, lock string
+	doc        frontierDocument
+	items      map[string]frontierItem
+	fault      error
+}
+
+func frontierKey(u string, depth int) string { return fmt.Sprintf("%d:%s", depth, u) }
+
+// Bind all scalar/slice options, excluding output destinations, seed lists,
+// invocation budgets and lifecycle callbacks. Changing a parsing/scope/transport
+// option invalidates reuse. Filters with process-local state are unsupported.
+func checkpointBinding(o *types.Options) (string, error) {
+	if o.Headless || o.HeadlessHybrid || o.AutomaticFormFill || o.AuthCredentials != "" || o.RecordedFlow != "" || len(o.CustomHeaders) > 0 || o.FilterSimilar || o.IgnoreQueryParams || o.PageContentSimilar || o.SimilarityDeduplication || o.MaxDomainPages > 0 || o.KnownFiles != "" || o.FormConfig != "" || o.FieldConfig != "" {
+		return "", errors.New("checkpoint requires anonymous standard GET crawl without stateful filters, known-files or page caps")
+	}
+	excluded := map[string]bool{}
+	for _, n := range []string{"URLs", "Resume", "Context", "OnResult", "OnSkipURL", "ReconCheckpointDir", "ReconCompletionLog", "ErrorLogFile", "OutputFile", "StoreResponseDir", "StoreFieldDir", "CrawlDuration", "Timeout", "Concurrency", "Parallelism", "RateLimit", "RateLimitMinute", "HostRateLimit", "HostRateLimitMinute", "Delay", "Silent", "Verbose", "Debug", "NoColors", "Version", "HealthCheck", "PprofServer", "DisableUpdateCheck"} {
+		excluded[n] = true
+	}
+	values := map[string]interface{}{}
+	v := reflect.ValueOf(o).Elem()
+	t := v.Type()
+	for i := 0; i < v.NumField(); i++ {
+		n := t.Field(i).Name
+		if !excluded[n] {
+			values[n] = v.Field(i).Interface()
+		}
+	}
+	// Compiled regexp fields must bind their expressions, not empty JSON objects.
+	patterns := []string{}
+	for _, r := range o.FilterRegex {
+		if r == nil {
+			return "", errors.New("nil checkpoint filter")
+		}
+		patterns = append(patterns, r.String())
+	}
+	values["FilterRegex"] = patterns
+	patterns = []string{}
+	for _, r := range o.MatchRegex {
+		if r == nil {
+			return "", errors.New("nil checkpoint filter")
+		}
+		patterns = append(patterns, r.String())
+	}
+	values["MatchRegex"] = patterns
+	b, err := json.Marshal(values)
+	if err != nil {
+		return "", err
+	}
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:]), nil
+}
+
+func validFrontierURL(raw string) bool {
+	u, e := url.Parse(raw)
+	return e == nil && (u.Scheme == "http" || u.Scheme == "https") && u.Host != "" && u.User == nil && len(raw) <= 8192
+}
+
+func openCheckpoint(dir, origin, binding string, maxDepth int, valid func(string) bool) (*reconCheckpoint, error) {
+	if !validFrontierURL(origin) {
+		return nil, errors.New("invalid checkpoint origin")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, err
+	}
+	st, err := os.Lstat(dir)
+	if err != nil {
+		return nil, err
+	}
+	if !st.IsDir() || st.Mode()&0077 != 0 {
+		return nil, errors.New("checkpoint directory must be private and not a symlink")
+	}
+	h := sha256.Sum256([]byte(origin))
+	path := filepath.Join(dir, hex.EncodeToString(h[:])+".json")
+	lock := path + ".lock"
+	f, err := os.OpenFile(lock, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return nil, fmt.Errorf("checkpoint is locked: %w", err)
+	}
+	if err = f.Close(); err != nil {
+		os.Remove(lock)
+		return nil, err
+	}
+	c := &reconCheckpoint{path: path, lock: lock, doc: frontierDocument{Contract: checkpointContract, Origin: origin, Binding: binding}, items: map[string]frontierItem{}}
+	success := false
+	defer func() {
+		if !success {
+			c.close()
+		}
+	}()
+	if st, err = os.Lstat(path); err == nil {
+		if !st.Mode().IsRegular() || st.Mode()&0077 != 0 || st.Size() > checkpointMaxBytes {
+			return nil, errors.New("unsafe checkpoint file")
+		}
+		file, e := os.Open(path)
+		if e != nil {
+			return nil, e
+		}
+		actual, e := file.Stat()
+		if e != nil || !os.SameFile(st, actual) {
+			file.Close()
+			return nil, errors.New("checkpoint changed during open")
+		}
+		data, e := io.ReadAll(io.LimitReader(file, checkpointMaxBytes+1))
+		file.Close()
+		if e != nil {
+			return nil, e
+		}
+		if len(data) > checkpointMaxBytes {
+			return nil, errors.New("checkpoint byte limit")
+		}
+		if e = rejectDuplicateKeys(data); e != nil {
+			return nil, e
+		}
+		if e = requireCheckpointFields(data); e != nil {
+			return nil, e
+		}
+		d := json.NewDecoder(bytes.NewReader(data))
+		d.DisallowUnknownFields()
+		if e = d.Decode(&c.doc); e != nil {
+			return nil, e
+		}
+		if e = d.Decode(new(interface{})); e != io.EOF {
+			return nil, errors.New("trailing checkpoint data")
+		}
+		if c.doc.Contract != checkpointContract || c.doc.Origin != origin || c.doc.Binding != binding || len(c.doc.Items) > checkpointMaxItems {
+			return nil, errors.New("checkpoint contract, origin, binding or size mismatch")
+		}
+		for _, item := range c.doc.Items {
+			if !validFrontierURL(item.URL) || item.Depth < 0 || item.Depth > maxDepth || !valid(item.URL) || len(item.Source) > 8192 || len(item.Tag) > 256 || len(item.Attribute) > 256 {
+				return nil, errors.New("checkpoint request violates current scope or depth")
+			}
+			key := frontierKey(item.URL, item.Depth)
+			if _, exists := c.items[key]; exists {
+				return nil, errors.New("duplicate checkpoint request")
+			}
+			c.items[key] = item
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, err
+	}
+	success = true
+	return c, nil
+}
+
+// Reject duplicate JSON object keys before Go's decoder could accept last wins.
+func rejectDuplicateKeys(data []byte) error {
+	d := json.NewDecoder(bytes.NewReader(data))
+	var value func(int) error
+	value = func(depth int) error {
+		if depth > 8 {
+			return errors.New("checkpoint nesting limit")
+		}
+		t, e := d.Token()
+		if e != nil {
+			return e
+		}
+		delim, ok := t.(json.Delim)
+		if !ok {
+			return nil
+		}
+		switch delim {
+		case '{':
+			seen := map[string]bool{}
+			for d.More() {
+				k, e := d.Token()
+				if e != nil {
+					return e
+				}
+				s, ok := k.(string)
+				if !ok || seen[s] {
+					return errors.New("duplicate checkpoint JSON key")
+				}
+				seen[s] = true
+				if len(seen) > 6 {
+					return errors.New("checkpoint field limit")
+				}
+				if e = value(depth + 1); e != nil {
+					return e
+				}
+			}
+		case '[':
+			count := 0
+			for d.More() {
+				count++
+				if count > checkpointMaxItems {
+					return errors.New("checkpoint item limit")
+				}
+				if e = value(depth + 1); e != nil {
+					return e
+				}
+			}
+		default:
+			return errors.New("unexpected checkpoint delimiter")
+		}
+		_, e = d.Token()
+		return e
+	}
+	if e := value(0); e != nil {
+		return e
+	}
+	if _, e := d.Token(); e != io.EOF {
+		return errors.New("trailing checkpoint data")
+	}
+	return nil
+}
+func (c *reconCheckpoint) saveLocked() error {
+	c.doc.Items = c.doc.Items[:0]
+	for _, item := range c.items {
+		c.doc.Items = append(c.doc.Items, item)
+	}
+	sort.Slice(c.doc.Items, func(i, j int) bool {
+		a, b := c.doc.Items[i], c.doc.Items[j]
+		if a.Depth != b.Depth {
+			return a.Depth < b.Depth
+		}
+		return a.URL < b.URL
+	})
+	b, e := json.Marshal(c.doc)
+	if e != nil {
+		return e
+	}
+	if len(b) > checkpointMaxBytes {
+		return errors.New("checkpoint byte limit")
+	}
+	f, e := os.CreateTemp(filepath.Dir(c.path), ".frontier-*")
+	if e != nil {
+		return e
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if e = f.Chmod(0600); e == nil {
+		_, e = f.Write(b)
+	}
+	if e == nil {
+		e = f.Sync()
+	}
+	ce := f.Close()
+	if e == nil {
+		e = ce
+	}
+	if e != nil {
+		return e
+	}
+	if e = os.Rename(name, c.path); e != nil {
+		return e
+	}
+	df, e := os.Open(filepath.Dir(c.path))
+	if e != nil {
+		return e
+	}
+	e = df.Sync()
+	ce = df.Close()
+	if e == nil {
+		e = ce
+	}
+	return e
+}
+func (c *reconCheckpoint) admit(x interface{}) error {
+	c.Lock()
+	defer c.Unlock()
+	if c.fault != nil {
+		return c.fault
+	}
+	r, ok := x.(*navigation.Request)
+	if !ok || len(r.Source) > 8192 || len(r.Tag) > 256 || len(r.Attribute) > 256 || r.Method != "GET" || r.Body != "" || len(r.Headers) > 0 || len(r.CustomFields) > 0 || !validFrontierURL(r.URL) {
+		c.fault = errors.New("unsupported checkpoint request; frontier not certified")
+		return c.fault
+	}
+	key := frontierKey(r.URL, r.Depth)
+	if _, exists := c.items[key]; exists {
+		return nil
+	}
+	if len(c.items) >= checkpointMaxItems {
+		c.fault = errors.New("checkpoint item limit")
+		return c.fault
+	}
+	c.items[key] = frontierItem{URL: r.URL, Depth: r.Depth, Source: r.Source, Tag: r.Tag, Attribute: r.Attribute}
+	c.fault = c.saveLocked()
+	return c.fault
+}
+func (c *reconCheckpoint) acknowledge(r *navigation.Request) error {
+	c.Lock()
+	defer c.Unlock()
+	if c.fault != nil {
+		return c.fault
+	}
+	key := frontierKey(r.URL, r.Depth)
+	item, ok := c.items[key]
+	if !ok {
+		return errors.New("unadmitted checkpoint work")
+	}
+	item.Done = true
+	c.items[key] = item
+	c.fault = c.saveLocked()
+	return c.fault
+}
+func (c *reconCheckpoint) snapshot() []frontierItem {
+	c.Lock()
+	defer c.Unlock()
+	out := []frontierItem{}
+	for _, i := range c.items {
+		out = append(out, i)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		return frontierKey(out[i].URL, out[i].Depth) < frontierKey(out[j].URL, out[j].Depth)
+	})
+	return out
+}
+func (c *reconCheckpoint) err() error { c.Lock(); defer c.Unlock(); return c.fault }
+func (c *reconCheckpoint) close()     { os.Remove(c.lock) }
+
+// Missing depth must not silently become zero on restore.
+func requireCheckpointFields(data []byte) error {
+	var root map[string]json.RawMessage
+	if err := json.Unmarshal(data, &root); err != nil {
+		return err
+	}
+	if len(root) != 4 {
+		return errors.New("checkpoint fields missing or unknown")
+	}
+	for _, k := range []string{"contract", "origin", "binding", "items"} {
+		if len(root[k]) == 0 || bytes.Equal(root[k], []byte("null")) {
+			return errors.New("checkpoint field absent")
+		}
+	}
+	var items []map[string]json.RawMessage
+	if err := json.Unmarshal(root["items"], &items); err != nil {
+		return err
+	}
+	for _, item := range items {
+		if len(item) < 3 || len(item) > 6 {
+			return errors.New("request fields missing or unknown")
+		}
+		for _, k := range []string{"url", "depth", "done"} {
+			if len(item[k]) == 0 || bytes.Equal(item[k], []byte("null")) {
+				return errors.New("request field absent")
+			}
+		}
+	}
+	return nil
+}
+
+func (c *reconCheckpoint) recheckSeed(origin string) error {
+	c.Lock()
+	defer c.Unlock()
+	key := frontierKey(origin, 0)
+	if _, exists := c.items[key]; !exists && len(c.items) >= checkpointMaxItems {
+		c.fault = errors.New("checkpoint item limit")
+		return c.fault
+	}
+	c.items[key] = frontierItem{URL: origin, Depth: 0}
+	c.fault = c.saveLocked()
+	return c.fault
+}
