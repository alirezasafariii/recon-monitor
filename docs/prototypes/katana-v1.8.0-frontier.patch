+)
+
+func TestReconProvenancePreservesResolutionInputs(t *testing.T) {
+	base, _ := url.Parse("https://example.test/a/index.html")
+	response := &navigation.Response{Resp: &http.Response{Request: &http.Request{URL: base}}, Depth: 1}
+	for _, tc := range []struct{ raw, expected string }{
+		{"proof.js", "https://example.test/a/proof.js"},
+		{"/proof.js", "https://example.test/proof.js"},
+		{"//cdn.example.test/proof.js", "https://cdn.example.test/proof.js"},
+		{"https://cdn.example.test/proof.js", "https://cdn.example.test/proof.js"},
+	} {
+		t.Run(tc.raw, func(t *testing.T) {
+			req := navigation.NewNavigationRequestURLFromResponse(tc.raw, base.String(), "script", "src", response)
+			path := filepath.Join(t.TempDir(), "provenance.jsonl")
+			if err := writeProvenance(path, req); err != nil {
+				t.Fatal(err)
+			}
+			data, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var record map[string]interface{}
+			if err := json.Unmarshal(data, &record); err != nil {
+				t.Fatal(err)
+			}
+			if record["raw_reference"] != tc.raw || record["url"] != tc.expected || record["source"] != base.String() {
+				t.Fatalf("lost resolution evidence: %s", data)
+			}
+			if _, ok := record["headers"]; ok {
+				t.Fatal("unexpected headers")
+			}
+		})
+	}
+}
+
+func TestReconProvenanceConcurrentAndBounded(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "records.jsonl")
+	request := &navigation.Request{RawReference: "/proof", URL: "https://example.test/proof", Source: "https://example.test/", Headers: map[string]string{"Authorization": "must-not-serialize"}, Body: "must-not-serialize"}
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := writeProvenance(path, request); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
+	if len(lines) != 32 {
+		t.Fatalf("lost concurrent records: %d", len(lines))
+	}
+	for _, line := range lines {
+		if !json.Valid([]byte(line)) {
+			t.Fatal("interleaved JSON")
+		}
+		if strings.Contains(line, "must-not-serialize") {
+			t.Fatal("serialized HTTP credentials or body")
+		}
+	}
+	file, err := os.OpenFile(path, os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = file.Truncate(8 * 1024 * 1024); err != nil {
+		t.Fatal(err)
+	}
+	file.Close()
+	if err = writeProvenance(path, request); err != nil {
+		t.Fatal(err)
+	}
+	info, _ := os.Stat(path)
+	if info.Size() != 8*1024*1024 {
+		t.Fatal("log grew beyond cap")
+	}
+}
