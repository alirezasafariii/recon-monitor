 	return items
 }
+
+// AdmissionError is read after workers have stopped.
+func (q *Queue) AdmissionError() error { q.Lock(); defer q.Unlock(); return q.pushError }
diff --git a/pkg/utils/queue/tracked_test.go b/pkg/utils/queue/tracked_test.go
new file mode 100644
index 0000000..3435c42
--- /dev/null
+++ b/pkg/utils/queue/tracked_test.go
@@ -0,0 +1,129 @@
+package queue
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+)
+
+func trackedReceive(t *testing.T, ch <-chan interface{}) interface{} {
+	t.Helper()
+	select {
+	case item, ok := <-ch:
+		if !ok {
+			t.Fatal("queue ended before work completed")
+		}
+		return item
+	case <-time.After(time.Second):
+		t.Fatal("queue failed to deliver work")
+		return nil
+	}
+}
+
+func trackedClosed(t *testing.T, ch <-chan interface{}) {
+	t.Helper()
+	select {
+	case _, ok := <-ch:
+		if ok {
+			t.Fatal("unexpected work")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("queue failed to close")
+	}
+}
+
+func TestTrackedQueueWaitsForActiveParentAndKeepsChildren(t *testing.T) {
+	for _, strategy := range []string{"depth-first", "breadth-first"} {
+		t.Run(strategy, func(t *testing.T) {
+			q, err := New(strategy, 30)
+			if err != nil {
+				t.Fatal(err)
+			}
+			q.Push("parent", 0)
+			items := q.PopTrackedWithContext(context.Background())
+			if trackedReceive(t, items) != "parent" {
+				t.Fatal("wrong parent")
+			}
+			select {
+			case <-items:
+				t.Fatal("empty queue was mistaken for completed crawl")
+			case <-time.After(20 * time.Millisecond):
+			}
+			q.Push("child", 0)
+			q.DoneItem()
+			if trackedReceive(t, items) != "child" {
+				t.Fatal("child lost")
+			}
+			q.DoneItem()
+			trackedClosed(t, items)
+		})
+	}
+}
+
+func TestTrackedQueueCancellationWhileWorkerActive(t *testing.T) {
+	q, _ := New("depth-first", 30)
+	q.Push("parent", 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	items := q.PopTrackedWithContext(ctx)
+	trackedReceive(t, items)
+	cancel()
+	trackedClosed(t, items)
+	q.DoneItem()
+}
+
+func TestTrackedQueueCancellationWhileSendBlocked(t *testing.T) {
+	q, _ := New("depth-first", 30)
+	q.Push("parent", 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	items := q.PopTrackedWithContext(ctx)
+	cancel()
+	trackedClosed(t, items)
+	q.Lock()
+	defer q.Unlock()
+	if q.active != 0 {
+		t.Fatal("discarded item leaked active reservation")
+	}
+}
+
+func TestTrackedEmptyQueueDoesNotWaitForRequestTimeout(t *testing.T) {
+	q, _ := New("depth-first", 30)
+	trackedClosed(t, q.PopTrackedWithContext(context.Background()))
+}
+
+func TestTrackedConcurrentParentsPreserveEveryChild(t *testing.T) {
+	for _, strategy := range []string{"depth-first", "breadth-first"} {
+		t.Run(strategy, func(t *testing.T) {
+			q, _ := New(strategy, 30)
+			for i := 0; i < 12; i++ {
+				q.Push(i, 0)
+			}
+			items := q.PopTrackedWithContext(context.Background())
+			var workers sync.WaitGroup
+			seen := make(map[int]bool)
+			var mu sync.Mutex
+			for item := range items {
+				value := item.(int)
+				workers.Add(1)
+				go func() {
+					defer workers.Done()
+					defer q.DoneItem()
+					if value < 12 {
+						q.Push(value+100, 0)
+					}
+					mu.Lock()
+					seen[value] = true
+					mu.Unlock()
+				}()
+			}
+			workers.Wait()
+			if len(seen) != 24 {
+				t.Fatalf("lost work: %v", seen)
+			}
+			pending, active := q.WorkState()
+			if pending != 0 || active != 0 {
+				t.Fatalf("leaked work: %d %d", pending, active)
+			}
+		})
+	}
+}
