+func TestReconCheckpointRejectsMalformedAndDuplicateJSON(t *testing.T) {
+	for _, raw := range []string{`{"contract":"x","contract":"y"}`, `{} {}`, `[[[[[[[[[[]]]]]]]]]]`, `{"items":[{"url":"x","url":"y"}]}`} {
