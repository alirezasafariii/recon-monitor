+}
+
+// DoneItem releases a tracked item after its children have been enqueued.
+func (q *Queue) DoneItem() {
+	q.Lock()
+	defer q.Unlock()
+	if q.active <= 0 {
+		panic("queue: unbalanced DoneItem")
+	}
+	q.active--
+	q.changed.Broadcast()
+}
+
+// WorkState is a synchronized snapshot of pending and tracked active work.
+func (q *Queue) WorkState() (int, int) {
+	q.Lock()
+	defer q.Unlock()
+	pending := q.stack.Len()
+	if q.Strategy == BreadthFirst {
+		pending = q.priorityQueue.Len()
+	}
+	return pending, q.active
+}
+
+// PopTrackedWithContext finishes only when pending and in-flight work are
+// both empty. Every delivered item must be paired with DoneItem.
+func (q *Queue) PopTrackedWithContext(ctx context.Context) chan interface{} {
+	items := make(chan interface{})
+	go func() {
+		defer close(items)
+		stop := context.AfterFunc(ctx, func() {
+			q.Lock()
+			q.changed.Broadcast()
+			q.Unlock()
+		})
+		defer stop()
+		for {
+			q.Lock()
+			var item interface{}
+			for {
+				if ctx.Err() != nil {
+					q.Unlock()
+					return
+				}
+				switch q.Strategy {
+				case BreadthFirst:
+					item = q.priorityQueue.Pop()
+				case DepthFirst:
+					item = q.stack.Pop()
+				}
+				if item != nil {
+					q.active++
+					break
+				}
+				if q.active == 0 {
+					q.Unlock()
+					return
+				}
+				q.changed.Wait()
+			}
+			q.Unlock()
+			select {
+			case items <- item:
+			case <-ctx.Done():
+				q.DoneItem()
+				return
+			}
+		}
+	}()
+	return items
 }
 
 // Pop pops elements from the queue (backward-compatible, no context).
@@ -129,3 +212,6 @@ func (q *Queue) PopWithContext(ctx context.Context) chan interface{} {
 
 	return items
 }
+
+// AdmissionError is read after workers have stopped.
+func (q *Queue) AdmissionError() error { q.Lock(); defer q.Unlock(); return q.pushError }
diff --git a/pkg/utils/queue/tracked_test.go b/pkg/utils/queue/tracked_test.go
new file mode 100644
index 0000000..3435c42
--- /dev/null
+++ b/pkg/utils/queue/tracked_test.go
@@ -0,0 +1,129 @@
+package queue
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+)
+
+func trackedReceive(t *testing.T, ch <-chan interface{}) interface{} {
+	t.Helper()
+	select {
+	case item, ok := <-ch:
+		if !ok {
+			t.Fatal("queue ended before work completed")
+		}
+		return item
+	case <-time.After(time.Second):
+		t.Fatal("queue failed to deliver work")
+		return nil
+	}
+}
+
+func trackedClosed(t *testing.T, ch <-chan interface{}) {
+	t.Helper()
+	select {
+	case _, ok := <-ch:
+		if ok {
+			t.Fatal("unexpected work")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("queue failed to close")
+	}
+}
+
+func TestTrackedQueueWaitsForActiveParentAndKeepsChildren(t *testing.T) {
+	for _, strategy := range []string{"depth-first", "breadth-first"} {
+		t.Run(strategy, func(t *testing.T) {
+			q, err := New(strategy, 30)
+			if err != nil {
+				t.Fatal(err)
+			}
+			q.Push("parent", 0)
+			items := q.PopTrackedWithContext(context.Background())
+			if trackedReceive(t, items) != "parent" {
+				t.Fatal("wrong parent")
+			}
+			select {
+			case <-items:
+				t.Fatal("empty queue was mistaken for completed crawl")
+			case <-time.After(20 * time.Millisecond):
+			}
+			q.Push("child", 0)
+			q.DoneItem()
+			if trackedReceive(t, items) != "child" {
+				t.Fatal("child lost")
+			}
+			q.DoneItem()
+			trackedClosed(t, items)
+		})
+	}
+}
+
+func TestTrackedQueueCancellationWhileWorkerActive(t *testing.T) {
+	q, _ := New("depth-first", 30)
+	q.Push("parent", 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	items := q.PopTrackedWithContext(ctx)
+	trackedReceive(t, items)
+	cancel()
+	trackedClosed(t, items)
+	q.DoneItem()
+}
+
+func TestTrackedQueueCancellationWhileSendBlocked(t *testing.T) {
+	q, _ := New("depth-first", 30)
+	q.Push("parent", 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	items := q.PopTrackedWithContext(ctx)
+	cancel()
+	trackedClosed(t, items)
+	q.Lock()
+	defer q.Unlock()
+	if q.active != 0 {
+		t.Fatal("discarded item leaked active reservation")
+	}
+}
+
+func TestTrackedEmptyQueueDoesNotWaitForRequestTimeout(t *testing.T) {
+	q, _ := New("depth-first", 30)
+	trackedClosed(t, q.PopTrackedWithContext(context.Background()))
+}
+
+func TestTrackedConcurrentParentsPreserveEveryChild(t *testing.T) {
+	for _, strategy := range []string{"depth-first", "breadth-first"} {
+		t.Run(strategy, func(t *testing.T) {
+			q, _ := New(strategy, 30)
+			for i := 0; i < 12; i++ {
+				q.Push(i, 0)
+			}
+			items := q.PopTrackedWithContext(context.Background())
+			var workers sync.WaitGroup
+			seen := make(map[int]bool)
+			var mu sync.Mutex
+			for item := range items {
+				value := item.(int)
+				workers.Add(1)
+				go func() {
+					defer workers.Done()
+					defer q.DoneItem()
+					if value < 12 {
+						q.Push(value+100, 0)
+					}
+					mu.Lock()
+					seen[value] = true
+					mu.Unlock()
+				}()
+			}
+			workers.Wait()
+			if len(seen) != 24 {
+				t.Fatalf("lost work: %v", seen)
+			}
+			pending, active := q.WorkState()
+			if pending != 0 || active != 0 {
+				t.Fatalf("leaked work: %d %d", pending, active)
+			}
+		})
+	}
+}
diff --git a/pkg/utils/script_endpoints.go b/pkg/utils/script_endpoints.go
new file mode 100644
index 0000000..dd13d95
--- /dev/null
+++ b/pkg/utils/script_endpoints.go
@@ -0,0 +1,76 @@
+package utils
+
+// ExtractScriptEndpoints keeps the existing endpoint heuristic but excludes
+// literal event names in object properties. This is not JavaScript evaluation:
+// unknown expressions remain candidates and must still pass normal scope checks.
+func ExtractScriptEndpoints(data string) []string {
+	masked := []byte(data)
+	previous, beforePrevious, beforeKey := "", "", ""
+	for i := 0; i < len(data); {
+		start := i
+		c := data[i]
+		if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
+			i++
+			continue
+		}
+		if c == '/' && i+1 < len(data) && data[i+1] == '/' {
+			for i < len(data) && data[i] != '\n' {
+				i++
+			}
+			continue
+		}
+		if c == '/' && i+1 < len(data) && data[i+1] == '*' {
+			i += 2
+			for i+1 < len(data) && !(data[i] == '*' && data[i+1] == '/') {
+				i++
+			}
+			if i+1 < len(data) {
+				i += 2
+			} else {
+				i = len(data)
+			}
+			continue
+		}
+		token := ""
+		if c == '\'' || c == '"' || c == '`' {
+			i++
+			for i < len(data) {
+				if data[i] == '\\' {
+					i += 2
+					continue
+				}
+				if data[i] == c {
+					i++
+					break
+				}
+				i++
+			}
+			if i > len(data) {
+				i = len(data)
+			}
+			if c != '`' && i >= start+2 && data[i-1] == c {
+				token = data[start+1 : i-1]
+				if previous == ":" && beforePrevious == "event" && (beforeKey == "{" || beforeKey == ",") {
+					for j := start; j < i; j++ {
+						masked[j] = ' '
+					}
+				}
+			}
+		} else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$' {
+			i++
+			for i < len(data) {
+				b := data[i]
+				if !((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_' || b == '$') {
+					break
+				}
+				i++
+			}
+			token = data[start:i]
+		} else {
+			token = data[i : i+1]
+			i++
+		}
+		beforeKey, beforePrevious, previous = beforePrevious, previous, token
+	}
+	return ExtractRelativeEndpoints(string(masked))
+}
diff --git a/pkg/utils/script_endpoints_test.go b/pkg/utils/script_endpoints_test.go
