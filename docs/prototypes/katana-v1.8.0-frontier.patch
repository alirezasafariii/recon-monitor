diff --git a/pkg/utils/bundle_references.go b/pkg/utils/bundle_references.go
new file mode 100644
index 0000000..34d79ae
--- /dev/null
+++ b/pkg/utils/bundle_references.go
@@ -0,0 +1,249 @@
+//go:build !(386 || windows)
+
+package utils
+
+import (
+	"reflect"
+	"strings"
+
+	"github.com/dop251/goja/ast"
+	"github.com/dop251/goja/parser"
+	"github.com/dop251/goja/token"
+)
+
+// MaskBundledModuleReferences removes only dependency keys and require literals
+// resolved to existing numeric modules in a Browserify-shaped module table.
+// Parsing never executes JavaScript. Offsets and unrelated URL uses are preserved.
+func MaskBundledModuleReferences(data string) string {
+	if len(data) > 2*1024*1024 || !strings.Contains(data, "require") {
+		return data
+	}
+	program, err := parser.ParseFile(nil, "", data, 0, parser.WithDisableSourceMaps)
+	if err != nil {
+		return data
+	}
+	masked := []byte(data)
+	mask := func(n ast.Node) {
+		start, end := int(n.Idx0())-1, int(n.Idx1())-1
+		if start < 0 || end > len(masked) || end < start {
+			return
+		}
+		for i := start; i < end; i++ {
+			if masked[i] != '\n' && masked[i] != '\r' {
+				masked[i] = ' '
+			}
+		}
+	}
+	numeric := func(e ast.Expression) string {
+		n, ok := e.(*ast.NumberLiteral)
+		if !ok || n.Literal == "" {
+			return ""
+		}
+		for _, c := range n.Literal {
+			if c < '0' || c > '9' {
+				return ""
+			}
+		}
+		return n.Literal
+	}
+	ident := func(e ast.Expression, name string) bool {
+		n, ok := e.(*ast.Identifier)
+		return ok && n.Name.String() == name
+	}
+	visitBundleAST(program, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpression)
+		if !ok {
+			return true
+		}
+		for _, argument := range call.ArgumentList {
+			table, ok := argument.(*ast.ObjectLiteral)
+			if !ok {
+				continue
+			}
+			modules := map[string]*ast.ArrayLiteral{}
+			seen := map[string]bool{}
+			ambiguous := false
+			for _, property := range table.Value {
+				p, ok := property.(*ast.PropertyKeyed)
+				if !ok || p.Computed || p.Kind != ast.PropertyKindValue {
+					ambiguous = true
+					break
+				}
+				id := numeric(p.Key)
+				if id == "" {
+					ambiguous = true
+					break
+				}
+				if seen[id] {
+					ambiguous = true
+					break
+				}
+				seen[id] = true
+				a, ok := p.Value.(*ast.ArrayLiteral)
+				if !ok || len(a.Value) != 2 {
+					continue
+				}
+				_, fn := a.Value[0].(*ast.FunctionLiteral)
+				_, deps := a.Value[1].(*ast.ObjectLiteral)
+				if fn && deps {
+					modules[id] = a
+				}
+			}
+			if ambiguous {
+				continue
+			}
+			for _, module := range modules {
+				fn := module.Value[0].(*ast.FunctionLiteral)
+				deps := module.Value[1].(*ast.ObjectLiteral)
+				if fn.ParameterList == nil || len(fn.ParameterList.List) == 0 || !ident(fn.ParameterList.List[0].Target, "require") || fn.ParameterList.List[0].Initializer != nil {
+					continue
+				}
+				ambiguousParams := fn.ParameterList.Rest != nil
+				for _, binding := range fn.ParameterList.List[1:] {
+					if bundleBindingContains(binding.Target, "require") {
+						ambiguousParams = true
+					}
+				}
+				if ambiguousParams {
+					continue
+				}
+				resolved := map[string]*ast.StringLiteral{}
+				seenKeys := map[string]bool{}
+				ambiguousKeys := false
+				for _, property := range deps.Value {
+					p, ok := property.(*ast.PropertyKeyed)
+					if !ok || p.Computed || p.Kind != ast.PropertyKindValue {
+						ambiguousKeys = true
+						break
+					}
+					key, ok := p.Key.(*ast.StringLiteral)
+					if !ok {
+						ambiguousKeys = true
+						break
+					}
+					name := key.Value.String()
+					if seenKeys[name] {
+						ambiguousKeys = true
+						break
+					}
+					seenKeys[name] = true
+					if modules[numeric(p.Value)] != nil {
+						resolved[name] = key
+					}
+				}
+				if ambiguousKeys || len(resolved) == 0 {
+					continue
+				}
+				shadowed := false
+				var args []*ast.StringLiteral
+				// Nested closures may inherit require, as Babel-generated Browserify modules
+				// do. Any local shadow, reassignment, eval or with makes the module ambiguous.
+				visitBundleAST(fn.Body, func(n ast.Node) bool {
+					switch b := n.(type) {
+					case *ast.Binding:
+						if bundleBindingContains(b.Target, "require") {
+							shadowed = true
+						}
+					case *ast.FunctionLiteral:
+						if b.Name != nil && b.Name.Name.String() == "require" {
+							shadowed = true
+						}
+					case *ast.CatchStatement:
+						if bundleBindingContains(b.Parameter, "require") {
+							shadowed = true
+						}
+					case *ast.AssignExpression:
+						if ident(b.Left, "require") {
+							shadowed = true
+						}
+					case *ast.UnaryExpression:
+						if (b.Operator == token.INCREMENT || b.Operator == token.DECREMENT) && ident(b.Operand, "require") {
+							shadowed = true
+						}
+					case *ast.WithStatement:
+						shadowed = true
+					case *ast.CallExpression:
+						if ident(b.Callee, "eval") {
+							shadowed = true
+						}
+						if ident(b.Callee, "require") && len(b.ArgumentList) == 1 {
+							if arg, ok := b.ArgumentList[0].(*ast.StringLiteral); ok && resolved[arg.Value.String()] != nil {
+								args = append(args, arg)
+							}
+						}
+					}
+					return !shadowed
+				})
+				if !shadowed {
+					for _, a := range args {
+						mask(a)
+					}
+					for _, key := range resolved {
+						mask(key)
+					}
+				}
+			}
+		}
+		return true
+	})
+	return string(masked)
+}
+
+// Only AST-owned fields are traversed; File, Source and DeclarationList contain
+// metadata or duplicate nodes. The dependency is pinned because its AST can evolve.
+func visitBundleAST(root ast.Node, visit func(ast.Node) bool) {
+	var walk func(reflect.Value)
+	walk = func(v reflect.Value) {
+		if !v.IsValid() {
+			return
+		}
+		if v.Kind() == reflect.Interface {
+			if v.IsNil() {
+				return
+			}
+			walk(v.Elem())
+			return
+		}
+		if v.Kind() == reflect.Pointer {
+			if v.IsNil() {
+				return
+			}
+			if v.CanInterface() {
+				if n, ok := v.Interface().(ast.Node); ok {
+					if !visit(n) {
+						return
+					}
+				}
+			}
+			walk(v.Elem())
+			return
+		}
+		switch v.Kind() {
+		case reflect.Struct:
+			if v.Type().PkgPath() != "github.com/dop251/goja/ast" {
+				return
+			}
+			for i := 0; i < v.NumField(); i++ {
+				name := v.Type().Field(i).Name
+				if name != "File" && name != "Source" && name != "DeclarationList" {
+					walk(v.Field(i))
+				}
+			}
+		case reflect.Slice:
+			for i := 0; i < v.Len(); i++ {
+				walk(v.Index(i))
+			}
+		}
+	}
+	walk(reflect.ValueOf(root))
+}
+func bundleBindingContains(root ast.Node, name string) bool {
+	found := false
+	visitBundleAST(root, func(n ast.Node) bool {
+		if i, ok := n.(*ast.Identifier); ok && i.Name.String() == name {
+			found = true
+		}
+		return !found
+	})
+	return found
+}
diff --git a/pkg/utils/bundle_references_test.go b/pkg/utils/bundle_references_test.go
new file mode 100644
index 0000000..b0d2c21
--- /dev/null
+++ b/pkg/utils/bundle_references_test.go
@@ -0,0 +1,71 @@
+//go:build !(386 || windows)
+
+package utils
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestScriptBundleResolvedDependencies(t *testing.T) {
+	s := `boot({1:[function(require,module,exports){module.exports=1},{}],2:[function(require,module,exports){var a=require("./address-suggestions.js");var b=require("./missing.js");fetch("./address-suggestions.js");},{"./address-suggestions.js":1,"./missing.js":99}]});`
+	got := MaskBundledModuleReferences(s)
+	if strings.Contains(got, `require("./address-suggestions.js")`) {
+		t.Fatal(got)
+	}
+	for _, want := range []string{`fetch("./address-suggestions.js")`, `require("./missing.js")`, `"./missing.js":99`} {
+		if !strings.Contains(got, want) {
+			t.Fatal(got)
+		}
+	}
+	if len(got) != len(s) {
+		t.Fatal("offsets changed")
+	}
+}
+func TestScriptBundlePreservesUnknownReferences(t *testing.T) {
+	for _, s := range []string{
+		`require("./address-suggestions.js");`,
+		`boot({1:[function(require,module,exports){require("./address-suggestions.js")},{"./address-suggestions.js":1,"./address-suggestions.js":99}]});`,
+		`boot({1:[function(require,module,exports){require("./address-suggestions.js")},{"./address-suggestions.js":1}],1:[]});`,
+		`boot({1:[function(require,module,exports){function require(){};require("./address-suggestions.js")},{"./address-suggestions.js":1}]});`,
+
+		`boot({1:[function(require,module,exports){require=custom;require("./address-suggestions.js")},{"./address-suggestions.js":1}]});`,
+		`boot({1:[function(require,module,exports){function inner(require){require("./address-suggestions.js")};},{"./address-suggestions.js":1}]});`,
+	} {
+		got := MaskBundledModuleReferences(s)
+		if !strings.Contains(got, `require("./address-suggestions.js")`) {
+			t.Fatal(got)
+		}
+	}
+}
+
+func TestScriptBundleNestedClosure(t *testing.T) {
+	s := `boot({1:[function(require,module,exports){module.exports=1},{}],2:[function(require,module,exports){(function(){var a=require("./address-suggestions.js");fetch("./address-suggestions.js")})();},{"./address-suggestions.js":1}]});`
+	got := MaskBundledModuleReferences(s)
+	if strings.Contains(got, `require("./address-suggestions.js")`) || strings.Contains(got, `"./address-suggestions.js":1`) {
+		t.Fatal(got)
+	}
+	if !strings.Contains(got, `fetch("./address-suggestions.js")`) {
+		t.Fatal("real URL use lost")
+	}
+}
+func TestScriptBundleRejectsInvalidSource(t *testing.T) {
+	s := `boot({1:[function(require,module,exports){require("./x.js")},{"./x.js":1}]});broken(`
+	if MaskBundledModuleReferences(s) != s {
+		t.Fatal("invalid source was masked")
+	}
+}
+func TestScriptBundleRejectsNestedShadows(t *testing.T) {
+	for _, body := range []string{
+		`function nested(require){require("./x.js")}`,
+		`function nested(){var require;require("./x.js")}`,
+		`try{}catch(require){require("./x.js")}`,
+		`function nested(){eval("require=custom");require("./x.js")}`,
+		`function nested(){require++;require("./x.js")}`,
+	} {
+		s := `boot({1:[function(require,module,exports){` + body + `},{"./x.js":1}]});`
+		if MaskBundledModuleReferences(s) != s {
+			t.Fatal(body)
+		}
+	}
+}
