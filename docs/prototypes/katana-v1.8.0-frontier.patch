+
+func TestReconCheckpointResumeRetainsFilteredAdmissionsWithoutFetching(t *testing.T) {
+	for _, done := range []bool{false, true} {
+		t.Run(fmt.Sprintf("filtered_done_%v", done), func(t *testing.T) {
+			shared, _ := newTestShared(2, func(o *types.Options) {
+				o.ReconCheckpointDir = t.TempDir()
+				o.Timeout = 5
+				o.Concurrency = 1
+			})
+			shared.Options.ExtensionsValidator = extensions.NewValidator(nil, nil, false)
+			dialer, e := fastdialer.NewDialer(fastdialer.DefaultOptions)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer dialer.Close()
+			shared.Options.Dialer = dialer
+			configured, e := NewShared(shared.Options)
+			if e != nil {
+				t.Fatal(e)
+			}
+			shared = configured
+			if err := os.Chmod(shared.Options.Options.ReconCheckpointDir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			seed := "http://example.test/"
+			binding, err := checkpointBinding(shared.Options.Options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c, err := openCheckpoint(shared.Options.Options.ReconCheckpointDir, seed, binding, 2, func(string) bool { return true })
+			if err != nil {
+				t.Fatal(err)
+			}
+			root := &navigation.Request{URL: seed, Method: "GET"}
+			image := &navigation.Request{URL: seed + "logo.png", Method: "GET", Depth: 1}
+			proof := &navigation.Request{URL: seed + "proof", Method: "GET", Depth: 1}
+			for _, r := range []*navigation.Request{root, image, proof} {
+				if err = c.admit(r); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err = c.acknowledge(root); err != nil {
+				t.Fatal(err)
+			}
+			if done {
+				if err = c.acknowledge(image); err != nil {
+					t.Fatal(err)
+				}
+			}
+			c.close()
+			session, err := shared.NewCrawlSessionWithURL(seed)
+			if err != nil {
+				t.Fatalf("valid checkpoint rejected because of filtered admission: %v", err)
+			}
+			defer session.CancelFunc()
+			calls := []string{}
+			err = shared.Do(session, func(_ *CrawlSession, r *navigation.Request) (*navigation.Response, error) {
+				calls = append(calls, r.URL)
+				return nil, errors.New("fixture retains unfinished allowed request")
+			})
+			if len(calls) != 1 || calls[0] != proof.URL {
+				t.Fatalf("filtered/root request fetched: %v", calls)
+			}
+			restored, err := openCheckpoint(shared.Options.Options.ReconCheckpointDir, seed, binding, 2, func(string) bool { return true })
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer restored.close()
+			for _, item := range restored.snapshot() {
+				if item.URL == image.URL && !item.Done {
+					t.Fatal("filtered request left pending")
+				}
+				if item.URL == proof.URL && item.Done {
+					t.Fatal("failed allowed request acknowledged")
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/engine/common/recon_completion.go b/pkg/engine/common/recon_completion.go
new file mode 100644
index 0000000..b800340
--- /dev/null
+++ b/pkg/engine/common/recon_completion.go
@@ -0,0 +1,99 @@
+package common
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/projectdiscovery/katana/pkg/navigation"
+	"os"
+	"sync"
+	"sync/atomic"
+)
+
+const completionContract = "recon.katana.standard.completion.v1"
+
+type reconCompletion struct {
+	Contract   string `json:"contract"`
+	Origin     string `json:"origin"`
+	StopReason string `json:"stop_reason"`
+	Attempted  int64  `json:"attempted_requests"`
+	Failed     int64  `json:"failed_requests"`
+	Limited    int64  `json:"limited_requests"`
+	Pending    int    `json:"pending_items"`
+	Active     int    `json:"active_items"`
+}
+
+func newCompletion(origin string, ctxErr error, attempted, failed, limited int64, pending, active int) reconCompletion {
+	reason := "queue_exhausted"
+	switch {
+	case errors.Is(ctxErr, context.DeadlineExceeded):
+		reason = "deadline"
+	case ctxErr != nil:
+		reason = "cancelled"
+	case limited > 0:
+		reason = "page_limit"
+	case failed > 0:
+		reason = "request_errors"
+	case attempted == 0 || pending != 0 || active != 0:
+		reason = "unknown"
+	}
+	return reconCompletion{completionContract, origin, reason, attempted, failed, limited, pending, active}
+}
+
+var completionMu sync.Mutex
+
+func writeCompletion(path string, report reconCompletion) error {
+	completionMu.Lock()
+	defer completionMu.Unlock()
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0600)
+	if err != nil {
+		return err
+	}
+	if err := json.NewEncoder(f).Encode(report); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	return f.Close()
+}
+
+// Fixed-size counters keep diagnostics bounded and separate from contract v1.
+type reconDiagnostics struct{ exact, similarity, missing atomic.Int64 }
+
+func (d *reconDiagnostics) observe(resp *navigation.Response) {
+	switch {
+	case resp != nil && resp.ReconSkipReason == "exact_content_duplicate":
+		d.exact.Add(1)
+	case resp != nil && resp.ReconSkipReason == "similarity_filtered":
+		d.similarity.Add(1)
+	default:
+		d.missing.Add(1)
+	}
+}
+func writeDiagnostics(path, origin string, d *reconDiagnostics) error {
+	completionMu.Lock()
+	defer completionMu.Unlock()
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0600)
+	if err != nil {
+		return err
+	}
+	report := struct {
+		Contract string           `json:"contract"`
+		Origin   string           `json:"origin"`
+		Reasons  map[string]int64 `json:"unparsed_reasons"`
+	}{
+		"recon.katana.standard.diagnostics.v1", origin, map[string]int64{
+			"exact_content_duplicate": d.exact.Load(), "similarity_filtered": d.similarity.Load(), "missing_response_reader": d.missing.Load()}}
+	if err := json.NewEncoder(f).Encode(report); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	return f.Close()
+}
